// Cloudflare Workers デプロイ設定
// デプロイ: npm run deploy(build して dist/ と Worker をアップロード)
// 初回のみ `npx wrangler login` でCloudflareアカウントにログインすること
// 管理ページのトークン: npx wrangler secret put ADMIN_TOKEN
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-art-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 存在しないパスでもトップページを返す(1ページ構成のため)
    "not_found_handling": "single-page-application",
    // この2経路だけWorkerが先に受ける。ほかは静的配信のまま
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  // 問い合わせの保存先。外部送信はせず、ここにしか残さない
  "kv_namespaces": [
    {
      "binding": "CONTACT_KV",
      "id": "f5b4810f0e134ff98325ba57b5d0a2fd"
    }
  ]
}
